NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<clerk publishable key>
CLERK_SECRET_KEY=<clerk secret key>
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding
# Neon + Prisma 7: pooled URL for app runtime (lib/prisma.ts); direct URL for Prisma CLI (prisma.config.ts).
# Add connect_timeout & pool_timeout on DATABASE_URL to reduce cold-start / pool wait errors.
# Example pooled: postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require&connect_timeout=15&pool_timeout=15
DATABASE_URL=<neon pooled connection string>
# Example direct: postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/DB?sslmode=require
DIRECT_URL=<neon direct connection string>
GEMINI_API_KEY=<google api key>
# Optional: override default model (e.g. gemini-2.0-flash). Change here only when Google updates model names.
# GEMINI_MODEL=gemini-2.0-flash-lite
